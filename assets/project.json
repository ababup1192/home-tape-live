  "web": {
    "startPrompt": "タッチして開始",
    "compress": {
      "lossyImages": [
        {
          "glob": "assets/bg/*.jpg",
          "quality": 85
        }
      ]
    },
    "embed": [
      "assets/talk/dialogue.json"
    ],
    "omit": [
      "assets/talk/*.yarn",
      "assets/*.schema.json"
    ],
    "// deferred": "押して始めた後に裏で取る素材（シナリオで出てくる順）。タイトルの写真（sudo_room）と環境音（tape_hiss）、タイトルで鳴る返事の音は起動時に取る。届く前に使う所は暗転で待つ（背景・環境音）か、鳴らさずに進む（一発の音）。",
    "deferred": [
      "assets/bg/my_room_tall.jpg",
